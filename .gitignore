# ---- Secrets / environment ----
.env
.env.*
!.env.example
secrets/*
!secrets/.gitkeep

# ---- PHI: NEVER commit patient data ----
# Uploaded medical records, generated outputs, and any extracted page maps.
uploads/
all_data_temp.txt
*.pdf
*.TRIAL.csv
*.TRIAL2.csv
# Vendor ("Outside") and app ("Inhouse") summary deliverables. These arrive as Word
# documents whose FILENAMES carry patient surnames, and neither gitleaks (secrets only)
# nor check-added-large-files (--maxkb=1024; these run 20-140 KB) would stop a commit.
# The working copy belongs on W:, which is PHI-bearing by design and off the network.
Record Reviews/
*.doc
*.docx
# docs/reference holds the category taxonomy and the MRR steps guide - both already tracked,
# both PHI-free, and CLAUDE.md points at them. Exempt so a future reference doc is not
# silently swallowed by the blanket rule above.
!docs/reference/*.doc
!docs/reference/*.docx
# Experiment spikes derive OCR text/labels from real records - keep caches out.
experiments/**/cache/
experiments/**/outputs/
*.jsonl

# ---- Virtual environments (disposable; recreated via uv) ----
.venv/
.venv-trial/
myenv/
venv/
env/

# ---- Exploratory spikes (carry hardcoded key fallbacks and/or PHI sample paths) ----
gemini_trial*.py
diag_slice.py

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Coverage (generated by pytest --cov; consumed by SonarCloud in CI) ----
.coverage
coverage.xml
htmlcov/
.scannerwork/

# ---- Personal Claude Code notes (per-developer; the shared context is CLAUDE.md) ----
CLAUDE.local.md

# ---- Tooling / OS ----
.playwright-mcp/
.DS_Store
Thumbs.db

# SQLite database (per-machine state; never commit)
instance/
# Working artefacts (plans, bug/task backlog) are local-only and never committed.
docs/plans/
docs/backlog.md
