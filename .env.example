# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Route Gemini calls to Vertex AI (BAA-covered) instead of AI Studio.
# Credentials: put a SERVICE-ACCOUNT KEY for this project at secrets/vertex-sa.json (compose mounts
# ./secrets read-only at /secrets, and secrets/* is git-ignored). A key authenticates on its own, so
# it does not expire the way a `gcloud auth application-default login` credential does - that one is
# an impersonation file backed by a human account and dies about daily, which silently stops every
# segment and summarize job until someone re-runs the login.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-sa.json

SECRET_KEY=
SECURITY_PASSWORD_SALT=

# Retry budget for a rejected Gemini call. 8 and 30 match the code defaults and are the recommended
# values: a segment job already burns ~17 minutes before it reports failure, so raising the retry
# count lengthens how long a job blocks without improving its odds of getting through the quota.
# This file advertised 10 and 60 from 2026-07-21 until 2026-07-31, but docker-compose.yml did not pass
# either key into the containers, so anyone who copied them got the code defaults regardless. Both are
# passed through now - see the x-backend-env block, and note that ANY key added here reaches a
# container only if compose names it.
GENAI_MAX_RETRIES=8
GENAI_RETRY_MAX_DELAY=30

# How many transient row failures with ZERO successes end a summarize job outright instead of pausing
# it for auto-resume. The pause path retries forever by design, which is right for a passing blip and
# wrong for a model that is refusing every call: on 2026-08-13 a summarize job spent 96 minutes
# resuming into a 0/8-admitted model before RQ's wall-clock cap killed it, and the reviewer saw only a
# generic message at the end of it. 3 matches the code default.
SUMMARIZE_GIVEUP_AFTER_FAILURES=3

# Per-attempt deadline in MILLISECONDS, and the two dials that decide how much work one segmentation
# vision call carries (and so whether it fits inside that deadline). All three were inert until
# 2026-08-13 - set here and ignored by the containers - so treat any older note about them with
# suspicion.
#
# GENAI_HTTP_TIMEOUT_MS is not just a client-side stall guard: google-genai forwards it to Vertex as
# the SERVER-side deadline, so a call needing longer comes back as a server 504 DEADLINE_EXCEEDED
# (proven 2026-08-12: an 8000 value produced a server 504 at 6.2s). A 504 is deliberately not
# retried, because the same deadline binds every attempt. 120000 stands on measurement now: with
# WINDOW_MAX_PAGES capping windows at 160 pages the slowest measured call is 54.5s. A deadline above
# 120000 IS honoured if a capped window ever runs long (a 179s call completed under a 600s deadline).
#
# WINDOW_BUDGET_MB bounds request SIZE; WINDOW_MAX_PAGES bounds request DURATION, which bytes cannot.
# A byte-LIGHT record packs a huge page count into one budget-sized window: document 68cb2500 is
# ~52KB/page, so all 241 of its pages landed in a single 12.5 MB window that needed 179s and failed
# 6/6. Measured 2026-08-12: 80 pages = 20.2s, 160 = 54.5s, 200 = 106.3s, 241 = 179.0s. Production
# windows of 180 and 188 pages errored 2/3 and 1/2, so 100 sits clearly below the failure onset.
# Set WINDOW_MAX_PAGES to something enormous (e.g. 10000) to disable the cap without a deploy.
#
# SEGMENT_THINKING_BUDGET=-1 is dynamic thinking. An A/B showed turning thinking OFF regresses strict
# doc-F1 because it over-segments, so if windows run long, lower WINDOW_MAX_PAGES first.
GENAI_HTTP_TIMEOUT_MS=120000
SEGMENT_THINKING_BUDGET=-1
WINDOW_BUDGET_MB=12.5
WINDOW_MAX_PAGES=100
WINDOW_OVERLAP=30

# GEMINI_THINKING_BUDGET is what every call OTHER than the segmentation window above inherits -
# that setting defines itself as the exception to this one, and only the exception was reachable.
# 0 is off, which is where it ships; set >0 or -1 (model-dynamic) if a task regresses.
GEMINI_THINKING_BUDGET=0

# The other three model knobs, so ANY model can be repointed without a rebuild. On 2026-08-13 Vertex
# refused gemini-2.5-pro for this project outright and SUMMARY_MODEL made that a one-line fix; these
# were code-only at the time. GENAI_MODEL = segmentation + header/DOI, VERIFY_MODEL = boundary verify,
# CLASSIFY_MODEL = categorization. Leave GENAI_MODEL and VERIFY_MODEL EMPTY to keep the derived
# defaults (genai from GOOGLE_GENAI_USE_VERTEXAI, verify from genai); naming one pins it.
GENAI_MODEL=
VERIFY_MODEL=
CLASSIFY_MODEL=gemini-2.5-flash-lite
SUMMARY_THINKING_BUDGET=-1

# THE FOUR EMERGENCY LEVERS, and every one of them was inert until 2026-09-18. Each documents itself
# in config.py as revertable from the environment; none was named in docker-compose.yml, so none
# reached a container however this file or a real .env was written. It surfaced mid-incident, with
# the pipeline on a self-hosted model and the audit destroying long summaries: SUMMARY_VERIFY=false
# was the obvious containment, was already set on the box, and did nothing.
#
# The values below ARE the defaults - setting them changes nothing until you need to turn one off.
#
# SUMMARY_MULTIMODAL is the one to think before pulling. Turning the page images off was measured to
# halve distinct measurements (13 -> 6) because the images are what recover tables, checkboxes and
# handwriting the OCR garbles. It is here so it CAN be moved, not so it should be.
SUMMARY_VERIFY=true
SUMMARY_MULTIMODAL=true
SUMMARY_TEMPERATURE=0.0
SUMMARY_MAX_OUTPUT_TOKENS=8192

# The boundary verify pass. These three were real settings ops had no way to find and no way to set:
# config.py defined them, docker-compose.yml did not name them, and this file did not advertise them,
# so they reached a container only through an image rebuild (#208). The defaults below ARE the
# intended values - setting them changes nothing until you want to tune one.
#
# VERIFY_SUSPECT_CAP is the one worth an experiment on a live box: 200 against roughly 88 boundaries
# per record means it never binds, so lowering it is the cheapest way to measure what checking fewer
# boundaries actually costs. VERIFY_USE_TEXT shows the model the rows' text as well as their
# metadata; VERIFY_MERGE lets a confirmed pair be offered as a one-click merge rather than flagged.
VERIFY_SUSPECT_CAP=200
VERIFY_USE_TEXT=true
VERIFY_MERGE=true

# The RQ budget for ONE job: JOB_TIMEOUT, or JOB_TIMEOUT_PER_PAGE x pages when larger. This is what
# hid a failure for 96 minutes on 2026-08-12 - a 289-page record buys 289 x 20 = 5780s, and a fully
# refused model burned all of it retrying before reporting anything. Cut it to fail faster.
JOB_TIMEOUT=3600
JOB_TIMEOUT_PER_PAGE=20.0

# The pacer's token ceiling; its request-side sibling VERTEX_MAX_RPM was already settable and this
# was not. Both are SAFETY BOUNDS, not tuning knobs - the AIMD controller finds the working rate
# under them. GENAI_RETRY_BASE_DELAY is the third retry dial alongside the two above.
VERTEX_MAX_TPM=4000000
GENAI_RETRY_BASE_DELAY=2.0

# Which model writes the summary BODY. Empty/unset means the code default (gemini-2.5-pro today).
# This is the fastest lever there is when a model loses capacity, and on 2026-08-12 it was dead: with
# Vertex refusing 2.5-pro for this project entirely, swapping to an available model needed a code
# change instead of one line here. Live as of 2026-08-13.
#
# Careful: SUMMARY_BODY_MODEL (in the OpenAI block below) does NOT control the body model on the
# Gemini path. The API resolves the body model from SUMMARY_MODEL and stamps it on the Job, so
# SUMMARY_BODY_MODEL only reaches the title and audit calls.
# SUMMARY_MODEL=gemini-3.5-flash
#
# Where the BODY call lands when Vertex will not serve SUMMARY_MODEL at all. Only reached after the
# retry seam has spent its whole budget and is still getting 429s - it is a fallback, not a race, and
# it fires once. Exists because the body left 2.5-pro for AVAILABILITY, not quality: on 2026-08-13
# Vertex refused 2.5-pro for this project outright, 0 of 8, and every summarize job failed; it
# recovered by itself the next day. Defaults ON to gemini-3.5-flash, because whoever raises
# SUMMARY_MODEL to a pro tier is exactly the person who will not have thought about this. A row
# answered by the fallback is stored with manual_check set and records the model that ACTUALLY
# answered in summaries.model, so a downgrade is never silent. Set to "none" to disable and let the
# row fail instead.
# SUMMARY_BODY_FALLBACK_MODEL=gemini-3.5-flash

# --- Vertex pacing (worker/queue scaling plan, changes 1 and 2) -----------------------------------
# Measured 2026-07-30/31: under active segmentation the shared pool served roughly 10 successful rpm
# while we attempted ~25, so about 60% of calls were 429 rejections - and a rejection still costs a
# bucket token, a worker-second and a retry slot. Three consecutive segment jobs died in the
# segmenting stage at 2/3 windows after 10-18 minutes each, producing nothing.
#
# vertex_max_rpm defaults to 60 in config.py; 20 sits just above the serviceable rate. The value must
# be the SAME in every process that calls Vertex (api and both workers): rate_limit.acquire() passes
# its own process's rate and capacity into the shared Redis bucket, so a process still running 60
# refills the bucket faster and partly defeats a lower setting elsewhere. Restart api AND both
# workers together after changing it.
VERTEX_MAX_RPM=20
# pipeline_workers is how many ROWS one summarize job processes concurrently, and it - not the Vertex
# quota - is what limits summarize throughput today. Measured 2026-08-03: 7.8 accepted calls/min
# against VERTEX_MAX_RPM=20, so the shared bucket runs at about 39% utilisation. Two concurrent
# chains at ~15.4s per call is exactly 7.8/min. The saturation point for a 20 rpm budget is
# 20/60 * 15.4 = ~5 concurrent rows; at 5 the budget is full and the limiter, not this setting,
# becomes the constraint again. Raise it in steps and watch the rejection rate
# (scripts/eval/vertex_stats.py), because filling the budget shifts the traffic mix toward
# 2.5-pro, whose shared pool is the smaller one.
#
# Do not push it far past the saturation point: rate_limit.acquire() gives up waiting after 300s and
# proceeds anyway, so enough queued callers bypass the limiter entirely.
PIPELINE_WORKERS=5

# segment_window_workers defaults to 3, i.e. one segment job fires three concurrent Vertex calls.
# A token bucket caps the average rate but permits a burst to capacity, and that burst shape is what
# trips the dynamic shared quota. Sequential windows are ~3x slower per document and far likelier to
# finish; a job that dies at 2/3 after 17 minutes has produced nothing at all.
SEGMENT_WINDOW_WORKERS=1

# --- Duplicate detection (accuracy gate, PR #66) --------------------------------------------------
# Leave these unset unless the gate is misjudging real records. Defaults live in app/config.py and
# these lines only restate them, so an unset key and the value below behave identically.
#
# dupe_jaccard_threshold is the candidate finder's word-overlap cut. The two overrides act on the
# accuracy gate that follows it: similarity at or above DUPE_SIMILARITY_OVERRIDE lets a candidate pass
# even when its members share no date or title, and at or above DUPE_MODEL_OVERRIDE the model is not
# consulted at all. Measured on 22 live clusters: real duplicates scored 0.994+, while every false
# positive was a recurring form series between 0.07 and 0.82.
#
# To restore the pre-#66 behaviour of sending every candidate to the model, set both overrides above
# 1.0 (e.g. 1.1) - no similarity can then satisfy either, so the gate stops short-circuiting.
# Lowering DUPE_JACCARD_THRESHOLD widens the candidate net and costs more Vertex calls.
# DUPE_JACCARD_THRESHOLD=0.70
# DUPE_SIMILARITY_OVERRIDE=0.90
# DUPE_MODEL_OVERRIDE=0.95

# Tesseract binary (installed but not on PATH -> OCR raises OcrUnavailableError).
# Single quotes, not double: python-dotenv processes escapes inside double quotes, so
# "...\tesseract.exe" parses with a literal TAB. Single quotes keep the path verbatim
# and also survive being sourced into a shell.
TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'

# --- Model backend (the whole pipeline) -----------------------------------------------------------
# Which backend answers model calls: "gemini", "openai" or "vllm". This is the switch; SUMMARY_PROVIDER
# below is the older, narrower one it supersedes.
#
# LLM_BACKEND_OVERRIDES routes individual stages differently, as comma-separated "stage=backend"
# pairs, e.g. "segment=gemini,classify=gemini". Valid stages: summarize, segment, extract, dedup,
# classify, verify, doi, deposition. A typo in either half REFUSES TO START rather than being
# ignored, because an ignored override leaves that stage where it was while looking like it moved.
#
# Overrides exist because a split outcome is the likely one. Measured 2026-09-11 against
# Qwen3.6-35B-A3B-FP8: level with Gemini on segmentation score, but it INVERTS the error direction
# (under-segmenting where Gemini over-segments, and an under-split hides a document inside another
# one where an over-split is visible to a reviewer), and it trailed on categorization.
LLM_BACKEND=gemini
LLM_BACKEND_OVERRIDES=

# --- Self-hosted vLLM -----------------------------------------------------------------------------
# Read only when some stage resolves to the vllm backend. The app then REFUSES TO START without
# VLLM_BASE_URL and VLLM_MODEL, and in production also refuses a base URL whose origin is not on the
# approved list in app/config.py.
#
# VLLM_BASE_URL is the OpenAI-compatible prefix and normally ends in /v1. The pod is reached through
# an SSH tunnel terminating inside it, so this is a loopback address: pod IPs and SSH ports are
# assigned at creation and differ every time, which is exactly why the tunnel exists and why this
# value does not change between pods.
#
# VLLM_MODEL must match the name the server actually loads. There is deliberately no default - a
# vLLM server serves exactly ONE model, so a wrong name is a 404 on the first call rather than a
# degraded result. The served name is stable across pods because we set it explicitly.
#
# VLLM_API_KEY is usually unset: vLLM does not require one, and --api-key guards only the /v1, /v2
# and /inference prefixes in any case (both /version and /metrics answer with no credential at all).
VLLM_BASE_URL=
VLLM_API_KEY=
VLLM_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# Client-side read deadline in SECONDS. Far longer than the Gemini path's 120s because it is a
# different kind of limit: GENAI_HTTP_TIMEOUT_MS is forwarded to Vertex as a SERVER deadline, while
# this one is ours alone and the pod has no proxy in front of it. Uncapped segmentation windows were
# measured at 179s, so 120 here would cut real work off mid-call.
VLLM_READ_TIMEOUT_S=600.0
# Pacer ceilings, 0 = OFF, which is where they ship. vLLM QUEUES instead of returning 429, so the
# AIMD controller never sees a rejection and can never lower the rate - the ceiling is the only
# control, and a wrong one is permanent. Every throughput figure we hold came from a sweep that sent
# no schema, so none of them can set these honestly yet.
VLLM_MAX_RPM=0
VLLM_MAX_TPM=0
# CVE floor. Checked at startup against the server's own GET /version; below it, the app refuses to
# start. Raise it deliberately, not to silence a failure.
VLLM_MIN_VERSION=0.24.0
# Extra approved destinations, comma-separated origins. HONOURED ONLY OUTSIDE PRODUCTION - prod
# ignores this and uses the list in app/config.py, so that widening where PHI may go is a reviewed
# diff and a deploy rather than an env edit. Ignored rather than rejected there, so a value left
# here cannot brick a production deploy.
VLLM_APPROVED_ORIGINS=

# --- What must agree with how the pod is served ---------------------------------------------------
# These are not vLLM connection settings, but they are the ones a pod brings into question, and two
# of them are checked by BOOT GUARDS - so a pod served differently from these values refuses to start
# the app rather than degrading quietly. Until 2026-09-16 none of them was referenced in
# docker-compose.yml, so the only way to change one was a code change and a deploy.
#
# One page becomes one image on the vLLM path. VLLM_MAX_IMAGES_PER_PROMPT mirrors the pod's
# --limit-mm-per-prompt, and the app refuses to start when the segment bound exceeds it: a window
# larger than the pod accepts dies on its first window, mid-run, on rented GPU time.
# How many page images ONE summarize row sends. Summarize rasterises on both backends, so this
# is not a vLLM-only number - but the boot guard refuses when it exceeds the pod's limit, so it
# must be clearable from the environment. The DOI and deposition reads cap at 10 and 6 as module
# CONSTANTS and are guarded too; those are measured values and deliberately not env knobs.
SUMMARY_IMAGE_MAX_PAGES=15
VLLM_SEGMENT_MAX_PAGES=30
VLLM_MAX_IMAGES_PER_PROMPT=40
# The render ceiling and the two per-stage pixel targets it caps. page_dpi fits the DPI to a target
# and then caps it here, so LOWERING SUMMARY_IMAGE_DPI silently shrinks the DOI and deposition reads
# below the resolution their numbers were chosen for. The app refuses to boot on that mismatch
# instead of rendering smaller. To raise a target, raise SUMMARY_IMAGE_DPI with it.
#
# Both targets are 1300 because a labelled injury date and a printed transcript page number are small
# fields; 1024 was measured on SEGMENTATION, which judges page layout. Neither 1300 has been measured
# on our own scans - see issue #333, to be answered on the next rented pod.
SUMMARY_IMAGE_DPI=120
DOI_IMAGE_LONG_EDGE_PX=1300
DEPOSITION_IMAGE_LONG_EDGE_PX=1300
# Output caps for the two isolated reads. Both count THOUGHT tokens and thinking is dynamic on these
# calls, so a cap chosen against Gemini's reasoning may not suit a pod model's. Truncation is now
# DETECTED on both, so a wrong value fails loudly rather than reporting a confident empty answer.
DOI_MAX_OUTPUT_TOKENS=2048
DEPOSITION_MAX_OUTPUT_TOKENS=2048

# --- Summarize stage provider -------------------------------------------------------------------
# The OLDER, NARROWER switch, kept because deployments set it today. It selects the vendor for the
# summarize stage's three calls (body, title, audit) and nothing else.
#
# PREFER LLM_BACKEND ABOVE. This key was never able to move the whole app: seven other services call
# google-genai directly and never consulted it. The previous version of this comment said
# "Segmentation, classification, dedup and DOI extraction are NOT affected by this and stay on Gemini
# regardless" - that was true of THIS key and is no longer true of the app, which is the point of
# LLM_BACKEND.
#
# While both exist, SUMMARY_PROVIDER=openai still wins for the summarize stage. Having a newly added
# setting silently override a live one would move production traffic to a different vendor on
# upgrade with nothing in the diff saying so.
SUMMARY_PROVIDER=gemini

# Set ONLY when SUMMARY_PROVIDER=openai. All four are required then - the app refuses to start
# otherwise, because a silent default model is how an unvalidated model reaches production.
#
# There is deliberately no recommended model here. OpenAI's own guidance is to fix an accuracy
# target on the most capable model and then step down to the cheapest that still meets it, so pick
# these by scoring against the frozen human baselines (90_Scripts/11_score_app_baseline.py), not by
# copying a value out of this file. The three are separate because the calls differ: the body call
# reads page images and applies a long format spec, the title is extraction from OCR text, and the
# audit is a check.
# OPENAI_API_KEY=sk-proj-...
# SUMMARY_BODY_MODEL=
# SUMMARY_TITLE_MODEL=
# AUDIT_MODEL=

# openai_max_rpm / openai_max_tpm in config.py are OPENAI'S OWN published ceilings, measured on the
# account 2026-08-03 (5,000 RPM, 1M TPM) - they are NOT a budget of ours and NOT a target to pace
# against. They serve as a cold-start bound only: observe_limits() replaces them with the real
# figures from the x-ratelimit-* headers OpenAI returns on every response. Anything pointing at a
# non-OpenAI endpoint wants them far lower, since nothing else serves 5,000 RPM.
#
# Both are currently ABSENT from docker-compose.yml's x-backend-env block, so setting them in .env
# has no effect on the containerised stack - the same trap that left VERTEX_MAX_RPM inert until #64
# and PIPELINE_WORKERS inert until #72. Name them in compose in the PR that first needs them.
# OPENAI_MAX_RPM=5000
# OPENAI_MAX_TPM=1000000

# PHI gate. A signed BAA is NOT sufficient on its own: OpenAI additionally requires Zero Data
# Retention (or Modified Abuse Monitoring / Eyes Off) approved on the ORGANIZATION. Check
# Settings > Organization > Data controls > Data retention, then set this to acknowledge it.
# Production refuses to start without it.
#
# Two consequences of ZDR that are NOT optional: only /v1/chat/completions may carry PHI, and the
# Batch API must never be used for it - batches are not ZDR-eligible, so its 50% discount is
# unavailable to this pipeline.
# OPENAI_ZDR_ACKNOWLEDGED=false
