# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Route Gemini calls to Vertex AI (BAA-covered) instead of AI Studio.
# Credentials: put a SERVICE-ACCOUNT KEY for this project at secrets/vertex-sa.json (compose mounts
# ./secrets read-only at /secrets, and secrets/* is git-ignored). A key authenticates on its own, so
# it does not expire the way a `gcloud auth application-default login` credential does - that one is
# an impersonation file backed by a human account and dies about daily, which silently stops every
# segment and summarize job until someone re-runs the login.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-sa.json

SECRET_KEY=
SECURITY_PASSWORD_SALT=

# Retry budget for a rejected Gemini call. 8 and 30 match the code defaults and are the recommended
# values: a segment job already burns ~17 minutes before it reports failure, so raising the retry
# count lengthens how long a job blocks without improving its odds of getting through the quota.
# This file advertised 10 and 60 from 2026-07-21 until 2026-07-31, but docker-compose.yml did not pass
# either key into the containers, so anyone who copied them got the code defaults regardless. Both are
# passed through now - see the x-backend-env block, and note that ANY key added here reaches a
# container only if compose names it.
GENAI_MAX_RETRIES=8
GENAI_RETRY_MAX_DELAY=30

# --- Vertex pacing (worker/queue scaling plan, changes 1 and 2) -----------------------------------
# Measured 2026-07-30/31: under active segmentation the shared pool served roughly 10 successful rpm
# while we attempted ~25, so about 60% of calls were 429 rejections - and a rejection still costs a
# bucket token, a worker-second and a retry slot. Three consecutive segment jobs died in the
# segmenting stage at 2/3 windows after 10-18 minutes each, producing nothing.
#
# vertex_max_rpm defaults to 60 in config.py; 20 sits just above the serviceable rate. The value must
# be the SAME in every process that calls Vertex (api and both workers): rate_limit.acquire() passes
# its own process's rate and capacity into the shared Redis bucket, so a process still running 60
# refills the bucket faster and partly defeats a lower setting elsewhere. Restart api AND both
# workers together after changing it.
VERTEX_MAX_RPM=20
# segment_window_workers defaults to 3, i.e. one segment job fires three concurrent Vertex calls.
# A token bucket caps the average rate but permits a burst to capacity, and that burst shape is what
# trips the dynamic shared quota. Sequential windows are ~3x slower per document and far likelier to
# finish; a job that dies at 2/3 after 17 minutes has produced nothing at all.
SEGMENT_WINDOW_WORKERS=1

# --- Duplicate detection (accuracy gate, PR #66) --------------------------------------------------
# Leave these unset unless the gate is misjudging real records. Defaults live in app/config.py and
# these lines only restate them, so an unset key and the value below behave identically.
#
# dupe_jaccard_threshold is the candidate finder's word-overlap cut. The two overrides act on the
# accuracy gate that follows it: similarity at or above DUPE_SIMILARITY_OVERRIDE lets a candidate pass
# even when its members share no date or title, and at or above DUPE_MODEL_OVERRIDE the model is not
# consulted at all. Measured on 22 live clusters: real duplicates scored 0.994+, while every false
# positive was a recurring form series between 0.07 and 0.82.
#
# To restore the pre-#66 behaviour of sending every candidate to the model, set both overrides above
# 1.0 (e.g. 1.1) - no similarity can then satisfy either, so the gate stops short-circuiting.
# Lowering DUPE_JACCARD_THRESHOLD widens the candidate net and costs more Vertex calls.
# DUPE_JACCARD_THRESHOLD=0.70
# DUPE_SIMILARITY_OVERRIDE=0.90
# DUPE_MODEL_OVERRIDE=0.95

# Tesseract binary (installed but not on PATH -> OCR raises OcrUnavailableError).
# Single quotes, not double: python-dotenv processes escapes inside double quotes, so
# "...\tesseract.exe" parses with a literal TAB. Single quotes keep the path verbatim
# and also survive being sourced into a shell.
TESSERACT_CMD='C:\Program Files\Tesseract-OCR\tesseract.exe'
